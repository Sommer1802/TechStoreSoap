<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore S.A.S</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/neon.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-dark navbar-neon mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Productos" asp-action="Index">TECH<span>STORE</span></a>
                <span class="navbar-text small d-none d-sm-inline">Cliente ASP.NET Core MVC · servicio SOAP</span>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Ok"] is string ok)
            {
                <div class="alert alert-success">@ok</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger">@err</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer-neon">
        TechStore S.A.S · Taller SOAP con <span>ASP.NET</span> y C#
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
